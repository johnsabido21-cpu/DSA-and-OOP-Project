import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.*;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.Random;

public class SpaceShooter extends JPanel implements ActionListener {
    static final int WIDTH = 1000;
    static final int HEIGHT = 600;

    JFrame frame;
    Timer timer = new Timer(16, this);
    Random random = new Random();

    double playerX = WIDTH / 2;
    double playerY = HEIGHT - 90;
    double aimAngle = -Math.PI / 2;
    int playerSpeed = 6;
    int health = 150;
    int score = 0;
    int kills = 0;
    int level = 1;
    int killsNeeded = 8;

    boolean left, right, up, down;
    boolean mouseShooting, paused, gameOver;

    ArrayList<Bullet> bullets = new ArrayList<>();
    ArrayList<Enemy> enemies = new ArrayList<>();
    ArrayList<Particle> particles = new ArrayList<>();
    ArrayList<PowerUp> powerUps = new ArrayList<>();

    int spawnCounter, fireCooldown, screenShake;
    int powerTimer;
    boolean multiShot = false;

    Color cyan = new Color(0, 245, 255);
    Color pink = new Color(255, 45, 150);
    Color purple = new Color(155, 70, 255);

    public SpaceShooter() {
        setPreferredSize(new Dimension(WIDTH, HEIGHT));
        setBackground(new Color(10, 9, 25));
        setFocusable(true);

        frame = new JFrame("NEON STRIKE");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(this);
        frame.pack();
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);

        setupControls();
        timer.start();
    }

    private void setupControls() {
        bind("A", "leftOn", () -> left = true);
        bind("D", "rightOn", () -> right = true);
        bind("W", "upOn", () -> up = true);
        bind("S", "downOn", () -> down = true);
        bind("ESCAPE", "pause", () -> { if (!gameOver) paused = !paused; });
        bind("R", "restart", () -> { if (gameOver) restartGame(); });

        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseMoved(MouseEvent e) { aimAt(e.getX(), e.getY()); }
        });
        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) mouseShooting = true;
            }
            public void mouseReleased(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) mouseShooting = false;
            }
        });
    }

    private void bind(String key, String name, Runnable action) {
        getInputMap(WHEN_IN_FOCUSED_WINDOW).put(KeyStroke.getKeyStroke("pressed " + key), name);
        getActionMap().put(name, new AbstractAction() {
            public void actionPerformed(ActionEvent e) { action.run(); }
        });
    }

    private void aimAt(int mx, int my) {
        aimAngle = Math.atan2(my - playerY, mx - playerX);
    }

    public void actionPerformed(ActionEvent e) {
        if (!paused && !gameOver) updateGame();
        repaint();
    }

    private void updateGame() {
        movePlayer();

        if (fireCooldown > 0) fireCooldown--;
        if (mouseShooting && fireCooldown == 0) {
            shoot();
            fireCooldown = multiShot ? 14 : 10;
        }

        if (powerTimer > 0) {
            powerTimer--;
            if (powerTimer == 0) multiShot = false;
        }

        spawnCounter++;
        int spawnDelay = Math.max(18, 55 - level * 8);
        if (spawnCounter >= spawnDelay) {
            spawnEnemy();
            spawnCounter = 0;
        }

        if (random.nextInt(220) == 0) powerUps.add(new PowerUp(random.nextDouble() * WIDTH, -20));

        updateBullets();
        updateEnemies();
        updatePowerUps();
        updateParticles();

        if (kills >= killsNeeded) {
            level++;
            killsNeeded += 8;
            JOptionPane.showMessageDialog(this, "⬆️ Level " + level);
        }

        if (screenShake > 0) screenShake--;
        if (health <= 0) gameOver = true;
    }

    private void movePlayer() {
        double dx = 0, dy = 0;
        if (left) dx--;
        if (right) dx++;
        if (up) dy--;
        if (down) dy++;
        if (dx != 0 && dy != 0) {
            dx *= 0.7071;
            dy *= 0.7071;
        }
        playerX += dx * playerSpeed;
        playerY += dy * playerSpeed;
        playerX = Math.max(24, Math.min(WIDTH - 24, playerX));
        playerY = Math.max(70, Math.min(HEIGHT - 25, playerY));
    }

    private void shoot() {
        double mx = playerX + Math.cos(aimAngle) * 30;
        double my = playerY + Math.sin(aimAngle) * 30;
        double spd = 12;

        if (multiShot) {
            bullets.add(new Bullet(mx, my, Math.cos(aimAngle - 0.12) * spd, Math.sin(aimAngle - 0.12) * spd));
            bullets.add(new Bullet(mx, my, Math.cos(aimAngle) * spd, Math.sin(aimAngle) * spd));
            bullets.add(new Bullet(mx, my, Math.cos(aimAngle + 0.12) * spd, Math.sin(aimAngle + 0.12) * spd));
        } else {
            bullets.add(new Bullet(mx, my, Math.cos(aimAngle) * spd, Math.sin(aimAngle) * spd));
        }
    }

    private void spawnEnemy() {
        int kind = random.nextInt(3);
        enemies.add(new Enemy(random.nextDouble() * (WIDTH - 60) + 30, -40, kind, level));
    }

    private void updateBullets() {
        Iterator<Bullet> it = bullets.iterator();
        while (it.hasNext()) {
            Bullet b = it.next();
            b.x += b.vx;
            b.y += b.vy;
            b.life--;
            if (b.life <= 0 || b.x < 0 || b.x > WIDTH || b.y < 0 || b.y > HEIGHT) {
                it.remove();
                continue;
            }
            for (Enemy en : enemies) {
                if (en.dead) continue;
                if (Point2D.distance(b.x, b.y, en.x, en.y) < en.radius + 5) {
                    en.hp--;
                    burst(b.x, b.y, cyan, 4);
                    it.remove();
                    if (en.hp <= 0) {
                        en.dead = true;
                        score += en.points;
                        kills++;
                        burst(en.x, en.y, en.color, 12);
                    }
                    break;
                }
            }
        }
        enemies.removeIf(en -> en.dead);
    }

    private void updateEnemies() {
        for (Enemy en : enemies) {
            en.y += en.speed;
            if (en.kind == 0) en.x += Math.sin(en.y * 0.035) * 1.5;

            if (en.y > HEIGHT + 35) {
                en.dead = true;
                health -= en.kind == 1 ? 12 : 8;
                screenShake = 4;
            }

            if (Point2D.distance(playerX, playerY, en.x, en.y) < en.radius + 18) {
                en.dead = true;
                health -= en.kind == 1 ? 18 : 10;
                screenShake = 7;
                burst(en.x, en.y, pink, 14);
            }
        }
        enemies.removeIf(en -> en.dead);
    }

    private void updatePowerUps() {
        Iterator<PowerUp> it = powerUps.iterator();
        while (it.hasNext()) {
            PowerUp pu = it.next();
            pu.y += 2;
            if (pu.y > HEIGHT + 20) {
                it.remove();
                continue;
            }
            if (Point2D.distance(playerX, playerY, pu.x, pu.y) < 32) {
                it.remove();
                multiShot = true;
                powerTimer = 240;
                burst(pu.x, pu.y, Color.GREEN, 8);
            }
        }
    }

    private void updateParticles() {
        Iterator<Particle> it = particles.iterator();
        while (it.hasNext()) {
            Particle p = it.next();
            p.x += p.vx;
            p.y += p.vy;
            p.life--;
            p.vx *= 0.96;
            p.vy *= 0.96;
            if (p.life <= 0) it.remove();
        }
    }

    private void burst(double x, double y, Color color, int count) {
        for (int i = 0; i < count; i++) particles.add(new Particle(x, y, color));
    }

    private void restartGame() {
        bullets.clear();
        enemies.clear();
        particles.clear();
        powerUps.clear();
        playerX = WIDTH / 2;
        playerY = HEIGHT - 90;
        health = 150;
        score = 0;
        kills = 0;
        level = 1;
        killsNeeded = 8;
        spawnCounter = fireCooldown = screenShake = powerTimer = 0;
        multiShot = paused = gameOver = mouseShooting = false;
        requestFocusInWindow();
    }

    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        if (screenShake > 0) g2.translate(random.nextInt(7) - 3, random.nextInt(7) - 3);

        drawBackground(g2);
        for (Particle p : particles) p.draw(g2);
        for (Bullet b : bullets) b.draw(g2);
        for (Enemy en : enemies) en.draw(g2);
        for (PowerUp pu : powerUps) pu.draw(g2);
        drawPlayer(g2);
        drawHUD(g2);

        if (paused) drawOverlay(g2, "PAUSED", "ESC to resume");
        if (gameOver) drawOverlay(g2, "SYSTEM FAILURE", "R to restart");
        g2.dispose();
    }

    private void drawBackground(Graphics2D g2) {
        GradientPaint bg = new GradientPaint(0, 0, new Color(12, 8, 28), 0, HEIGHT, new Color(35, 10, 45));
        g2.setPaint(bg);
        g2.fillRect(0, 0, WIDTH, HEIGHT);

        int roadTop = HEIGHT - 170;
        g2.setColor(new Color(13, 12, 27));
        g2.fillRect(0, roadTop, WIDTH, HEIGHT - roadTop);
        g2.setColor(pink);
        g2.setStroke(new BasicStroke(2));
        g2.drawLine(0, roadTop, WIDTH, roadTop);
    }

    private void drawPlayer(Graphics2D g2) {
        Graphics2D p = (Graphics2D) g2.create();
        p.translate(playerX, playerY);
        p.rotate(aimAngle);
        p.setColor(cyan);
        p.fillRoundRect(0, -4, 38, 8, 5, 5);
        p.dispose();

        Polygon ship = new Polygon();
        ship.addPoint((int) playerX, (int) playerY - 22);
        ship.addPoint((int) playerX + 22, (int) playerY + 10);
        ship.addPoint((int) playerX - 22, (int) playerY + 10);
        g2.setColor(new Color(25, 35, 65));
        g2.fillPolygon(ship);
        g2.setColor(cyan);
        g2.drawPolygon(ship);
    }

    private void drawHUD(Graphics2D g2) {
        g2.setFont(new Font("Monospaced", Font.BOLD, 16));
        g2.setColor(Color.WHITE);
        g2.drawString("Score: " + score, 28, 60);
        g2.drawString("Level: " + level, 28, 82);
        g2.drawString(multiShot ? "🔥 MultiShot ACTIVE" : "", 28, 104);

        g2.setColor(new Color(60, 30, 50));
        g2.fillRoundRect(28, 110, 190, 10, 5, 5);
        g2.setColor(health > 30 ? new Color(0, 255, 140) : pink);
        g2.fillRoundRect(28, 110, 190 * health / 150, 10, 5, 5);
    }

    private void drawOverlay(Graphics2D g2, String title, String subtitle) {
        g2.setColor(new Color(5, 5, 20, 210));
        g2.fillRect(0, 0, WIDTH, HEIGHT);
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 30));
        g2.drawString(title, WIDTH / 2 - title.length() * 9, HEIGHT / 2 - 30);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 18));
        g2.drawString(subtitle, WIDTH / 2 - subtitle.length() * 7, HEIGHT / 2 + 10);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(SpaceShooter::new);
    }

    static class Bullet {
        double x, y, vx, vy;
        int life = 100;
        Bullet(double x, double y, double vx, double vy) {
            this.x = x;
            this.y = y;
            this.vx = vx;
            this.vy = vy;
        }
        void draw(Graphics2D g) {
            g.setColor(Color.WHITE);
            g.fillOval((int) x - 3, (int) y - 3, 6, 6);
        }
    }

    static class Enemy {
        double x, y, speed;
        int kind, hp, points, radius;
        boolean dead;
        Color color;
        Enemy(double x, double y, int kind, int level) {
            this.x = x;
            this.y = y;
            this.kind = kind;
            if (kind == 0) {
                speed = 2.8 + level * 0.15;
                hp = 1;
                points = 10;
                radius = 15;
                color = new Color(255, 45, 150);
            } else if (kind == 1) {
                speed = 1.3 + level * 0.1;
                hp = 2 + level / 2;
                points = 30;
                radius = 21;
                color = new Color(155, 70, 255);
            } else {
                speed = 4.2 + level * 0.18;
                hp = 1;
                points = 20;
                radius = 12;
                color = new Color(255, 170, 35);
            }
        }
        void draw(Graphics2D g) {
            g.setColor(color);
            if (kind == 0) g.fillOval((int) x - radius, (int) y - radius, radius * 2, radius * 2);
            else if (kind == 1) g.fillRoundRect((int) x - radius, (int) y - radius, radius * 2, radius * 2, 8, 8);
            else {
                Polygon tri = new Polygon();
                tri.addPoint((int) x, (int) y + radius);
                tri.addPoint((int) x - radius, (int) y - radius);
                tri.addPoint((int) x + radius, (int) y - radius);
                g.fillPolygon(tri);
            }
        }
    }

    static class PowerUp {
        double x, y;
        PowerUp(double x, double y) {
            this.x = x;
            this.y = y;
        }
        void draw(Graphics2D g) {
            g.setColor(Color.GREEN);
            g.fillOval((int) x - 10, (int) y - 10, 20, 20);
            g.setColor(Color.WHITE);
            g.drawString("M", (int) x - 4, (int) y + 4);
        }
    }

    static class Particle {
        double x, y, vx, vy;
        int life = 20;
        Color color;
        Particle(double x, double y, Color color) {
            this.x = x;
            this.y = y;
            this.color = color;
            double ang = Math.random() * Math.PI * 2;
            double spd = 1 + Math.random() * 4;
            vx = Math.cos(ang) * spd;
            vy = Math.sin(ang) * spd;
        }
        void draw(Graphics2D g) {
            g.setColor(new Color(color.getRed(), color.getGreen(), color.getBlue(), Math.max(0, life * 12)));
            g.fillOval((int) x - 3, (int) y - 3, 6, 6);
        }
    }
}
